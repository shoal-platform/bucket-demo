# Name of the Google Cloud Storage bucket used to store uploaded files (required)
BUCKET_NAME=your-bucket-name

# Port the API listens on (optional, defaults to 8080)
PORT=8080

# Path to a service account key JSON file (optional)
# Leave unset if you use `gcloud auth application-default login`
# or run on Google Cloud with an attached service account.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
